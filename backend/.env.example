PORT=3000
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
DATABASE_URL=postgresql://username:password@localhost:5432/database

# Public base URL this server is reachable at — used to build links (e.g.
# the /share/posts/:id page shared for a post) that point back at itself.
# No trailing slash.
APP_URL=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRES_IN=6h

# Leave SMTP_HOST unset to log reset-password emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@socialapp.local

RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Max size (in MB) for profile photo uploads.
MAX_UPLOAD_SIZE_MB=7.5

# Max size (in MB) for post/reel media uploads (images and video) — separate
# ceiling from MAX_UPLOAD_SIZE_MB since video is much larger than a photo.
MAX_POST_MEDIA_SIZE_MB=100

# Max size (in MB) for chat attachments — images, video, PDF, and voice
# notes/audio. Separate ceiling from the other two upload caps.
MAX_CHAT_ATTACHMENT_SIZE_MB=9

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
